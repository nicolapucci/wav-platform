DATABASE_URL=postgresql://wav:wav@postgres:5432/wav
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting su auth-service (vedi services/auth-service/app/main.py)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=wavminio
S3_SECRET_KEY=wavminio123
S3_BUCKET=wav-attachments

# OAuth2 (opzionale, vedi TODO in services/auth-service/app/main.py)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Let's Encrypt (deploy pubblico, vedi README): tutto commentato = self-signed in
# sviluppo. DOMAIN è un nome DNS che punta alla macchina; senza un dominio proprio va
# bene <ip-con-trattini>.sslip.io, ad es. 203-0-113-10.sslip.io per l'IP 203.0.113.10.
# DOMAIN=
# LETSENCRYPT_EMAIL=            # facoltativa: avvisi di scadenza
# LETSENCRYPT_STAGING=1         # server di prova, per la prima volta; poi toglierlo
# COMPOSE_PROFILES=letsencrypt  # tiene attivo il servizio certbot (rinnovo automatico)

# Password dei container postgres/minio stessi, lette da docker-compose.yml
# (non da wav_core): devono coincidere con la password dentro DATABASE_URL e con
# S3_SECRET_KEY qui sopra - cambiarne una senza le altre rompe l'accesso.
POSTGRES_PASSWORD=wav
MINIO_ROOT_PASSWORD=wavminio123
